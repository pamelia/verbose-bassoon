    {
      "id": "hablar-yo",
      "kind": "Regular -ar verb",
      "prompt": "Yo ___ un poco de español.",
      "translation": "I speak a little Spanish.",
      "verb": "hablar",
      "person": "1st person singular",
      "clue": "habl- + -o",
      "answers": [
        "hablo"
      ],
      "answer": "hablo",
      "note": "For regular present-tense verbs, yo ends in -o."
    },
